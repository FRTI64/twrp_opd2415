#
# qseecomd is started from a setup script once the block device nodes
# (in particular /dev/block/by-name/ssd, used by the SSD storage listener
# for the TEE apps) exist. Starting it on init races ueventd and leaves the
# TEE gatekeeper/keymaster without their secure storage.

on late-init
    start qseecomd_setup

service qseecomd_setup /vendor/bin/start_qseecomd.sh
    class late_start
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

service vendor.qseecomd /vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

on property:vendor.car.hiber=hiberExit
   stop vendor.qseecomd
   start vendor.qseecomd
