<!--
    Recovery VINTF manifest for OPD2415/OPD2413 (erhai).
    In recovery, servicemanager only reads /system/etc/vintf/manifest.xml
    and /system/etc/vintf/manifest/ (VintfObjectRecovery). Without the
    AIDL HAL declarations here, every AIDL service registration
    (keymint, gatekeeper, health, boot, ...) is rejected and keystore2
    cannot connect to KeyMint -> data decryption fails.
-->
<manifest version="8.0" type="device" target-level="202404">
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::IServiceManager/default</fqname>
        <fqname>@1.1::IServiceManager/default</fqname>
        <fqname>@1.2::IServiceManager/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <sepolicy>
        <version>202404</version>
    </sepolicy>
</manifest>
