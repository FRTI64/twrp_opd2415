# Keystore2 service for TWRP recovery.
# Overrides the system keystore2.rc (which runs as user "keystore" with
# /data/misc/keystore and crash-loops in recovery because /data is not
# mounted/decrypted yet).
#
# Mirrors bootable/recovery/etc/init/keystore2.rc: run as root with the
# database in /tmp so keystore2 stays alive before /data decryption.

on late-init
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    task_profiles ProcessCapacityHigh
    # The default memlock limit of 65536 bytes is too low for keystore.
    rlimit memlock unlimited unlimited
    critical window=0
    seclabel u:r:recovery:s0
