# Keystore2 service for TWRP recovery.
# Uses the older keystore2 build from color597's working erhai TWRP (V1 AIDL):
# the AOSP 16 keystore2 enforces user-auth-bound key operations without an
# auth token, which breaks the synthetic password blob unwrap.
#
# The binary lives in /system/bin and its matching libs (including a full
# libcrypto with CBS_* symbols) in /system/lib64/keystore2_old.

on late-init
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    setenv LD_LIBRARY_PATH /system/lib64/keystore2_old:/system/lib64
    task_profiles ProcessCapacityHigh
    # The default memlock limit of 65536 bytes is too low for keystore.
    rlimit memlock unlimited unlimited
    critical window=0
    seclabel u:r:recovery:s0
